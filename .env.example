# ALTravel PostgreSQL Development Environment Variables (Placeholders)
# Copy this file to .env and adjust variables as needed for local development.

POSTGRES_DB=altravel
POSTGRES_USER=altravel
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_PORT=5432

# Spring Boot Data Source Variables
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/altravel
SPRING_DATASOURCE_USERNAME=altravel
SPRING_DATASOURCE_PASSWORD=your_secure_password_here
