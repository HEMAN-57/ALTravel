# TripSync PostgreSQL & Backend Environment Variables (Example Template)
# Copy this file to .env and adjust variables as needed for local deployment.

# PostgreSQL Configuration
POSTGRES_DB=altravel
POSTGRES_USER=altravel
POSTGRES_PASSWORD=altravel_dev_password
POSTGRES_PORT=5432

# Spring Boot DataSource
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/altravel
SPRING_DATASOURCE_USERNAME=altravel
SPRING_DATASOURCE_PASSWORD=altravel_dev_password

# Server & Security
SERVER_PORT=8080
JWT_SECRET=your_custom_256bit_hex_or_base64_jwt_secret_here
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Frontend Environment (Vite)
VITE_API_URL=http://localhost:8080/api
